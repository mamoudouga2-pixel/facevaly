<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve existing files and folders as-is (assets, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React Router: all other paths fall back to the SPA entry
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>
